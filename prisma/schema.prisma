generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Two roles only (GLOSSARY.md): Owner has full rights; Cataloger helps
// catalog but must never see cost prices or record sales.
enum Role {
  OWNER
  CATALOGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CATALOGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
}

// A signed-in browser holds a random session token in an httpOnly cookie;
// the database stores only the SHA-256 hash of that token.
model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
