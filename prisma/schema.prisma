generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Two roles only (GLOSSARY.md): Owner has full rights; Cataloger helps
// catalog but must never see cost prices or record sales.
enum Role {
  OWNER
  CATALOGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CATALOGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions   Session[]
  valuations Valuation[]
}

// A signed-in browser holds a random session token in an httpOnly cookie;
// the database stores only the SHA-256 hash of that token.
model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// The six v1 categories (GLOSSARY.md) plus Other for anything outside them.
// Each defines the attribute schema its Items carry; the templates live in
// src/lib/catalog/categories.ts.
enum ItemCategory {
  FURNITURE
  CERAMICS_PORCELAIN
  ART_PAINTINGS
  BOOKS
  WATCH
  PEN
  OTHER
}

// Item states in order (GLOSSARY.md): Draft -> Cataloged -> Listed ->
// Reserved -> Sold -> Shipped. Sold Items stay in the Catalog forever.
// Each state has exactly one successor (src/lib/lifecycle/lifecycle.ts);
// reaching Listed internationally is gated on Export Clearance (ADR-0002).
enum ItemState {
  DRAFT
  CATALOGED
  LISTED
  RESERVED
  SOLD
  SHIPPED
}

// Export clearance (ADR-0002): a 50+ year Item cannot be Listed
// internationally until both the SKBCB certificate number and a scan of the
// certificate are recorded. The scan is one Cloudinary original (folder
// antiques/certificates); its display URL is derived like any photo. Nulls
// mean "not cleared yet" — the gate treats number and scan as a pair.
model Item {
  id                     String       @id @default(cuid())
  name                   String
  category               ItemCategory
  state                  ItemState    @default(DRAFT)
  fiftyYearsOld          Boolean      @default(true)
  conditionNotes         String?
  provenance             String?
  costBasisIdr           Int?
  skbcbCertificateNumber String?
  skbcbScanPublicId      String?
  skbcbScanFormat        String?
  attributes             Json
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  photos      Photo[]
  comparables Comparable[]
  valuations  Valuation[]
  listings    Listing[]

  @@index([state])
  @@index([category])
}

// Cost basis (IDR) is visible to the Owner only: the read actions never
// select it for a Cataloger, and the write action requires the Owner role —
// enforced on the server, not just hidden in the UI.

// Recorded evidence of sold prices for items similar to this one
// (GLOSSARY.md: Comparables). The basis of the Owner's Valuation.
// Money is a Decimal(12,2) in the currency named by `currency`, because
// marketplaces pay in USD/EUR/GBP (2 dp) while IDR has none.
model Comparable {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  source    String
  url       String?
  soldOn    DateTime
  price     Decimal  @db.Decimal(12, 2)
  currency  String
  notes     String?
  createdAt DateTime @default(now())

  @@index([itemId])
}

// One row per time the Owner sets a Valuation price range — the table is
// the history (GLOSSARY.md: a range decided by a human, never automatic).
model Valuation {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  minPrice  Decimal  @db.Decimal(12, 2)
  maxPrice  Decimal  @db.Decimal(12, 2)
  currency  String
  setById   String
  setBy     User     @relation(fields: [setById], references: [id])
  createdAt DateTime @default(now())

  @@index([itemId])
}

// How a forwarder charges (ticket 05): express parcel per kilogram of
// chargeable weight, sea freight per cubic meter of volume.
enum RateBasis {
  PER_KG
  PER_CUBIC_METER
}

// The Owner-editable rates table (GLOSSARY-adjacent: forwarder × destination
// zone). One row per forwarder and zone; every number is editable so the
// estimates match reality without code changes (spec story 28). Seeded from
// the research findings (.scratch/research/export-and-forwarders.md and
// furniture-marketplaces-europe.md) — the seed values are starting points,
// not quotes. Money is IDR (whole rupiah, like cost basis).
model ForwarderRate {
  id             String    @id @default(cuid())
  forwarder      String
  zone           String
  basis          RateBasis
  rateIdr        Int
  // DHL Express caps a piece at 70 kg, Pos Indonesia EMS at 30 kg; heavier
  // pieces must move as freight. Null = no piece-weight limit.
  maxKgPerPiece  Int?
  // Volumetric rule for express parcel (cm³ per chargeable kg, DHL uses
  // 5000). Null = the basis bills actual weight / volume only.
  volumetricDivisor Int?
  // Insurance as a percentage of declared value (DHL Express insured: 2%),
  // with a floor per shipment (DHL: IDR 170,000). 0% = not priced in.
  insurancePercent  Decimal @db.Decimal(5, 2)
  insuranceMinimumIdr Int?
  transitNote     String?
  updatedAt       DateTime  @updatedAt

  @@unique([forwarder, zone])
}

// The external sales channels (GLOSSARY.md: Marketplace). v1 lists on eBay
// and Etsy (plus Tokopedia for domestic selling); the fee percentage is what
// the Price Floor subtracts and is editable because marketplace fee
// schedules change. `region` is which side of the export gate (ADR-0002) the
// channel sits on: Indonesian marketplaces are domestic, everything the
// buyer buys from abroad is international.
enum MarketplaceRegion {
  DOMESTIC
  INTERNATIONAL
}

model Marketplace {
  id         String           @id @default(cuid())
  name       String
  region     MarketplaceRegion
  feePercent Decimal          @db.Decimal(5, 2)
  updatedAt  DateTime         @updatedAt

  listings Listing[]

  @@unique([name])
}

// One offer to sell one Item on one Marketplace (GLOSSARY.md: Listing) —
// one Item can be offered on several channels at once. Statuses move
// forward only, like the Item lifecycle: PLANNED (recorded, draft package
// being prepared) → ACTIVE (live on the marketplace) → ENDED (taken down
// or replaced by a new Listing). Activating a Listing on an international
// Marketplace is where the export gate binds for offers (ticket 06); the
// Item's own Draft→Cataloged→Listed… lifecycle keeps tracking the piece.
enum ListingStatus {
  PLANNED
  ACTIVE
  ENDED
}

// Money is a Decimal(12,2) in the currency named by `currency` — the
// marketplace's own currency (eBay/Etsy pay in USD/EUR/GBP-style 2-decimal
// currencies; Tokopedia would carry IDR).
model Listing {
  id           String        @id @default(cuid())
  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String
  marketplace  Marketplace   @relation(fields: [marketplaceId], references: [id])
  marketplaceId String
  price        Decimal       @db.Decimal(12, 2)
  currency     String
  status       ListingStatus @default(PLANNED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([itemId])
  @@index([itemId, status])
}

// Singleton row (id "main") holding the Owner's pricing settings: the margin
// applied on top of costs, and the one editable FX rate (spec story 32) that
// converts between IDR costs and marketplace-currency prices. No live
// currency APIs — the Owner sets the number they trust.
model PricingSetting {
  id        String   @id
  // Margin as a percentage of cost basis + shipping + insurance.
  marginPercent      Decimal @db.Decimal(5, 2)
  // The marketplace-currency side of the single FX rate and how many IDR
  // one unit of it costs (e.g. USD / 16,000).
  fxMarketplaceCurrency String
  fxIdrPerUnit       Decimal @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt
}

// One stored original per photo; marketplace-sized variants are derived
// Cloudinary URLs, not stored files.
model Photo {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  publicId  String
  format    String
  width     Int
  height    Int
  position  Int
  createdAt DateTime @default(now())

  @@index([itemId])
}
