generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Two roles only (GLOSSARY.md): Owner has full rights; Cataloger helps
// catalog but must never see cost prices or record sales.
enum Role {
  OWNER
  CATALOGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CATALOGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  valuations  Valuation[]
}

// A signed-in browser holds a random session token in an httpOnly cookie;
// the database stores only the SHA-256 hash of that token.
model Session {
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// The six v1 categories (GLOSSARY.md) plus Other for anything outside them.
// Each defines the attribute schema its Items carry; the templates live in
// src/lib/catalog/categories.ts.
enum ItemCategory {
  FURNITURE
  CERAMICS_PORCELAIN
  ART_PAINTINGS
  BOOKS
  WATCH
  PEN
  OTHER
}

// Item states in order (GLOSSARY.md): Draft -> Cataloged -> Listed ->
// Reserved -> Sold -> Shipped. Sold Items stay in the Catalog forever.
// Ticket 02 only moves Items Draft -> Cataloged; the later transitions and
// the export gate arrive with the lifecycle ticket.
enum ItemState {
  DRAFT
  CATALOGED
  LISTED
  RESERVED
  SOLD
  SHIPPED
}

// Cost basis (IDR) is visible to the Owner only. The column lives here, but
// the read actions never select it for a Cataloger, and the write action
// requires the Owner role — enforced on the server, not just hidden in the UI.
model Item {
  id             String       @id @default(cuid())
  name           String
  category       ItemCategory
  state          ItemState    @default(DRAFT)
  fiftyYearsOld  Boolean      @default(true)
  conditionNotes String?
  provenance     String?
  costBasisIdr   Int?
  attributes     Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  photos      Photo[]
  comparables Comparable[]
  valuations  Valuation[]

  @@index([state])
  @@index([category])
}

// Recorded evidence of sold prices for items similar to this one
// (GLOSSARY.md: Comparables). The basis of the Owner's Valuation.
// Money is a Decimal(12,2) in the currency named by `currency`, because
// marketplaces pay in USD/EUR/GBP (2 dp) while IDR has none.
model Comparable {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  source    String
  url       String?
  soldOn    DateTime
  price     Decimal  @db.Decimal(12, 2)
  currency  String
  notes     String?
  createdAt DateTime @default(now())

  @@index([itemId])
}

// One row per time the Owner sets a Valuation price range — the table is
// the history (GLOSSARY.md: a range decided by a human, never automatic).
model Valuation {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  minPrice  Decimal  @db.Decimal(12, 2)
  maxPrice  Decimal  @db.Decimal(12, 2)
  currency  String
  setById   String
  setBy     User     @relation(fields: [setById], references: [id])
  createdAt DateTime @default(now())

  @@index([itemId])
}

// One stored original per photo; marketplace-sized variants are derived
// Cloudinary URLs, not stored files.
model Photo {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  publicId  String
  format    String
  width     Int
  height    Int
  position  Int
  createdAt DateTime @default(now())

  @@index([itemId])
}
