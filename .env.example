# Copy this file to `.env` and adjust for your machine.
# Loaded by Prisma CLI (via prisma7.config.ts + dotenv) and by Next.js automatically.

# PostgreSQL used by `npm run dev`. Created by `docker compose up -d`.
DATABASE_URL="postgresql://antiques:antiques@localhost:5432/antiques_dev"

# First Owner account created by `npm run db:seed`.
# `antiques-owner-1` is fine on your own machine; in production set a long
# random password instead. Never commit the real production values.
SEED_OWNER_EMAIL="owner@antiques.local"
SEED_OWNER_PASSWORD="antiques-owner-1"
SEED_OWNER_NAME="Owner"

# Cloudinary photo storage (free tier: cloudinary.com). Dashboard → Account
# Details → Copy API Key, API Secret, and Cloud Name. Until these are set,
# items can still be recorded, but photo upload is disabled (see README).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
